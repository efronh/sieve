+"""The early-exit block loop (`HFBackend.hidden_states_to`) against the plain forward, on a tiny
+random Llama, under whichever transformers is installed (4.53+ or 5). Skipped without torch."""
+import numpy as np
+import pytest
+
+pytest.importorskip("torch")
+pytest.importorskip("transformers")
+
+from anyjev import Decider, Question  # noqa: E402
+
+MODEL = "hf-internal-testing/tiny-random-LlamaForCausalLM"
+PROMPTS = ["card declined at checkout", "the app crashes when I open settings", "hi"]
+
+
+@pytest.fixture(scope="module")
+def backend():
+    from anyjev.backends.hf import HFBackend
+
+    try:
+        return HFBackend(MODEL, device="cpu", dtype="float32")
+    except OSError as e:   # offline and not cached
+        pytest.skip(f"{MODEL} not available: {e}")
+
+
+@pytest.mark.engine
+def test_block_loop_matches_the_plain_forward(backend):
+    # prompts of different lengths, so the left-padded batch path is exercised too
+    for layer in (1, backend.n_layers):
+        loop = backend.hidden_states_to(PROMPTS, [layer], max_layer=layer)[0]
+        plain = backend.hidden_states(PROMPTS, [layer])[0]
+        np.testing.assert_allclose(loop, plain, atol=1e-5)
+
+
+@pytest.mark.engine
+def test_l2_decisions_stop_early(backend):
+    q = Question.choice("Which handler?", ["billing", "technical"], name="route")
+    states = [f"{p} {i}" for i in range(8) for p in PROMPTS]
+    dec = Decider(backend, level="L2")
+    dec.fit_head(q, states, [i % 2 for i in range(len(states))], layers=[1])
+    d = dec.decide(states[0], [q])[0]
+    assert d.level == "L2"
+    assert dec.early_stop_error is None and d.diagnostics["early_stop"] is True
